# Supabase project URL.
#
# ONLY the project URL - no path. Do NOT paste the REST endpoint:
#   correct: https://<project-ref>.supabase.co
#   WRONG:   https://<project-ref>.supabase.co/rest/v1/
#
# A trailing path breaks sign-in in a very confusing way: the auth client appends
# /auth/v1/authorize, producing /rest/v1/auth/v1/authorize, and PostgREST answers
# "No API key found in request" - an error that points at the key instead of the URL.
# lib/env.ts strips such a path and warns, but set it correctly anyway.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Publishable (anon) key. Safe to expose: it identifies the project and grants no
# data access, because Row Level Security is enabled on every table with no policy
# for `anon`.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# The project's JWT secret (Project Settings -> API -> JWT Settings).
# Used to sign the app's own session tokens. SERVER ONLY - never expose this.
SUPABASE_JWT_SECRET=

# Service role key. Bypasses RLS entirely, so only two things may use it, both
# because no user identity exists to authorize the operation: verifying a child's
# PIN before a session is issued, and uploading a proof image to Storage. SERVER ONLY.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection string, used only by scripts/migrate.mjs.
# Use the "Session pooler" URI from Project Settings -> Database, and keep the
# password percent-encoded.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- Web Push -------------------------------------------------------------------
# Generate a pair with: npx web-push generate-vapid-keys --json
#
# The public key is handed to the browser when it subscribes, so it is public by
# design and has to be a NEXT_PUBLIC_ variable to be inlined into the bundle.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Signs the VAPID token on every push. Anyone holding this can send notifications
# to every subscribed device, so it is SERVER ONLY and must never be committed.
VAPID_PRIVATE_KEY=

# Contact for the push service, used if a subscription misbehaves. Must be a
# mailto: address or an https: URL. Use the deployed origin.
VAPID_SUBJECT=https://<your-app>.vercel.app
