# Normalise line endings in the repository.
#
# Windows tooling (PowerShell, some editors) writes CRLF, while CI runs on Linux.
# Without this, a file edited on Windows shows up as a whole-file rewrite, and a
# stray encoding mistake can make Git treat a text file as binary.
#
# `text=auto` stores text as LF in the repository and checks it out with the
# platform's native ending, so a Windows developer keeps CRLF locally without
# polluting history.
* text=auto

# Shell scripts and Dockerfiles must stay LF even on Windows.
*.sh text eol=lf
Dockerfile text eol=lf

# These are generated by Next.js and read by tsc. Keep them LF so a Windows
# checkout and the Linux CI runner see identical bytes.
*.ts text eol=lf
*.tsx text eol=lf
*.mjs text eol=lf
*.js text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.css text eol=lf
*.md text eol=lf
*.sql text eol=lf

# Binary assets must never be line-ending converted.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
