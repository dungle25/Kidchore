# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# The example file contains placeholders only and is meant to be committed.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local scratch files
commitmsg.txt
commit-msg-*.txt
*.tmp

# git worktrees, for running two agents on two branches at once.
# See CONVENTIONS.md section 6.10 for why this exists and what it does NOT protect.
/.worktrees/

# downloaded CI logs
ci-log-*.txt

# exported env values for deploy (never commit secrets)
vercel-env.txt

# Local MCP server config for whichever editor is on this machine.
#
# This file holds credentials by design - an MCP server that talks to a hosted service
# needs a token to do it - and it is per-machine anyway, because the tools it points at
# are installed here. So it is ignored for the same reason .env.local is, rather than
# because of what happens to be in it today.
mcp.json

# Screen captures produced by scripts/screenshot-for-design.mjs.
#
# Regenerable in one command, and 1.6 MB of PNGs per run would bloat the repository for
# something that is a working file rather than a deliverable.
design-screenshots/

# Self-contained HTML exports and the design system copy, produced by
# scripts/export-static-html.mjs for upload to Google Stitch. Same reasoning: generated,
# and large. The design system itself is committed at docs/DESIGN.md.
.stitch/
